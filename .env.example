# Optional override; the distributed public app token is read automatically.
# PUBLIK_APP_TOKEN=
# Required for hosting; at least 32 cryptographically random characters. Never expose through NEXT_PUBLIC_.
# STUDSMITH_SESSION_SECRET=
# Non-Vercel hosted origin, e.g. https://your-app.example (no trailing slash).
# STUDSMITH_APP_ORIGIN=
# Set DO_NOT_TRACK=1 or PUBLIK_TELEMETRY=off to disable usage counting.
